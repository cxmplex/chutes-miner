[Unit]
Description=One-use legacy GPU custody cutover
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/chutes/legacy-gpu-cutover
ConditionPathExists=|/run/chutes/legacy-gpu-cutover.json
ConditionPathExists=|/var/lib/chutes/legacy-gpu-cutover/state.json
ConditionPathExists=|/etc/chutes/legacy-gpu-cutover/fence.json

[Service]
Type=oneshot
User=root
Group=root
Environment=KUBECONFIG=/run/chutes/legacy-k3s-admin.yaml
ExecStart=/usr/bin/nsenter --target 1 --mount -- /usr/local/bin/chutes-miner l0 gpu-legacy-cutover-run --bundle-path /run/chutes/legacy-gpu-cutover.json
RemainAfterExit=no
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/chutes /cache/storage /var/snap /var/lib/rancher /var/lib/kubelet /var/lib/chutes /etc/chutes/legacy-gpu-cutover /etc/rancher /etc/admission-controller
NoNewPrivileges=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
