[Unit]
Description=Fence K3s and legacy GPU storage during unfinished custody cutover
DefaultDependencies=no
Before=k3s.service systemd-cryptsetup@storage.service systemd-cryptsetup@tdx\x2dcache.service cache-storage.mount var-snap.mount
ConditionPathExists=/etc/chutes/legacy-gpu-cutover/fence.json

[Service]
Type=oneshot
ExecStart=/usr/local/bin/chutes-miner l0 gpu-legacy-cutover-fence
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/chutes/legacy-gpu-cutover
