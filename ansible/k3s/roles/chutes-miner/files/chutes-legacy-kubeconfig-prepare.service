[Unit]
Description=Prepare ephemeral legacy K3s admin access
Requires=k3s.service
After=k3s.service
Before=k3s-post-start.service chutes-legacy-gpu-cutover.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/chutes/prepare-legacy-kubeconfig
RemainAfterExit=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/run/chutes
NoNewPrivileges=yes
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
